{
  "speech_engine": "edge-tts / Microsoft Edge online TTS",
  "voice": "zh-CN-XiaoxiaoNeural",
  "rate": "+8%",
  "segments": [
    {
      "id": "01",
      "start": 0.15,
      "latest_end": 2.9,
      "text": "课表，作业，资料。",
      "file": "audio/voice-01.wav",
      "raw_duration": 2.496,
      "duration": 1.9223333333333332,
      "speed_adjustment": 1,
      "end": 2.0723333333333334
    },
    {
      "id": "02",
      "start": 3.15,
      "latest_end": 5.9,
      "text": "接进同一个学习流程。",
      "file": "audio/voice-02.wav",
      "raw_duration": 2.28,
      "duration": 1.7383125,
      "speed_adjustment": 1,
      "end": 4.8883125
    },
    {
      "id": "03",
      "start": 6.15,
      "latest_end": 8.9,
      "text": "一张截图，变成待办。",
      "file": "audio/voice-03.wav",
      "raw_duration": 2.472,
      "duration": 1.9194166666666668,
      "speed_adjustment": 1,
      "end": 8.069416666666667
    },
    {
      "id": "04",
      "start": 9.3,
      "latest_end": 12.9,
      "text": "助手整理出作业要求。",
      "file": "audio/voice-04.wav",
      "raw_duration": 2.4,
      "duration": 1.8394166666666667,
      "speed_adjustment": 1,
      "end": 11.139416666666667
    },
    {
      "id": "05",
      "start": 13.15,
      "latest_end": 15.9,
      "text": "日期，可以之后补充。",
      "file": "audio/voice-05.wav",
      "raw_duration": 2.304,
      "duration": 1.8088125,
      "speed_adjustment": 1,
      "end": 14.9588125
    },
    {
      "id": "06",
      "start": 16.15,
      "latest_end": 17.9,
      "text": "确认，再保存。",
      "file": "audio/voice-06.wav",
      "raw_duration": 2.016,
      "duration": 1.4763541666666666,
      "speed_adjustment": 1,
      "end": 17.626354166666665
    },
    {
      "id": "07",
      "start": 18.15,
      "latest_end": 22.7,
      "text": "已有课程，一起考虑。",
      "file": "audio/voice-07.wav",
      "raw_duration": 2.4,
      "duration": 1.8498333333333334,
      "speed_adjustment": 1,
      "end": 19.99983333333333
    },
    {
      "id": "08",
      "start": 23.15,
      "latest_end": 26.8,
      "text": "生成学习安排草稿。",
      "file": "audio/voice-08.wav",
      "raw_duration": 2.28,
      "duration": 1.7165625,
      "speed_adjustment": 1,
      "end": 24.866562499999997
    },
    {
      "id": "09",
      "start": 27.15,
      "latest_end": 30.8,
      "text": "由你确认，才进入日程。",
      "file": "audio/voice-09.wav",
      "raw_duration": 2.592,
      "duration": 2.0593541666666666,
      "speed_adjustment": 1,
      "end": 29.209354166666664
    },
    {
      "id": "10",
      "start": 31.15,
      "latest_end": 33.9,
      "text": "资料，按课程收好。",
      "file": "audio/voice-10.wav",
      "raw_duration": 2.328,
      "duration": 1.7842916666666666,
      "speed_adjustment": 1,
      "end": 32.93429166666667
    },
    {
      "id": "11",
      "start": 34.15,
      "latest_end": 37.9,
      "text": "带着原文提问，回答标明来源。",
      "file": "audio/voice-11.wav",
      "raw_duration": 3.144,
      "duration": 2.601395833333333,
      "speed_adjustment": 1,
      "end": 36.75139583333333
    },
    {
      "id": "12",
      "start": 38.15,
      "latest_end": 40.9,
      "text": "每次专注二十五分钟。",
      "file": "audio/voice-12.wav",
      "raw_duration": 2.352,
      "duration": 1.8349166666666668,
      "speed_adjustment": 1,
      "end": 39.98491666666666
    },
    {
      "id": "13",
      "start": 41.15,
      "latest_end": 44.8,
      "text": "确认之后，才会记住。",
      "file": "audio/voice-13.wav",
      "raw_duration": 2.4,
      "duration": 1.8727291666666666,
      "speed_adjustment": 1,
      "end": 43.022729166666664
    },
    {
      "id": "14",
      "start": 45.15,
      "latest_end": 48.8,
      "text": "换个对话，继续记得。",
      "file": "audio/voice-14.wav",
      "raw_duration": 2.328,
      "duration": 1.7662916666666666,
      "speed_adjustment": 1,
      "end": 46.916291666666666
    },
    {
      "id": "15",
      "start": 49.15,
      "latest_end": 50.95,
      "text": "关上主窗口。",
      "file": "audio/voice-15.wav",
      "raw_duration": 1.872,
      "duration": 1.14975,
      "speed_adjustment": 1,
      "end": 50.299749999999996
    },
    {
      "id": "16",
      "start": 51.15,
      "latest_end": 54.0,
      "text": "桌宠仍能查看今日待办。",
      "file": "audio/voice-16.wav",
      "raw_duration": 2.592,
      "duration": 2.0172083333333335,
      "speed_adjustment": 1,
      "end": 53.167208333333335
    },
    {
      "id": "17",
      "start": 54.3,
      "latest_end": 56.85,
      "text": "从截图，到安排。",
      "file": "audio/voice-17.wav",
      "raw_duration": 2.112,
      "duration": 1.6037083333333333,
      "speed_adjustment": 1,
      "end": 55.90370833333333
    },
    {
      "id": "18",
      "start": 57.2,
      "latest_end": 61.25,
      "text": "课间，让学习安排更清楚。",
      "file": "audio/voice-18.wav",
      "raw_duration": 2.808,
      "duration": 2.2523958333333334,
      "speed_adjustment": 1,
      "end": 59.452395833333334
    }
  ],
