# 启动脚本会从项目根目录读取 .env；密钥只保留在服务端。
DATABASE_URL=sqlite+aiosqlite:///./data/campus.db
AGENT_DB_PATH=./data/agent.db
UPLOAD_DIR=./data/uploads
PUBLIC_ORIGIN=http://127.0.0.1:5173
SECURE_COOKIE=false
APP_MODE=local
# 仅在明确需要同一后端多设备账号登录时设为 shared；桌面启动器强制local。
REGISTRATION_ENABLED=true
MODEL_PROVIDER=openai
TEXT_MODEL=
VISION_MODEL=
# 低成本候选：TEXT_MODEL=gpt-6-luna，VISION_MODEL=gpt-6-luna；填密钥后运行 verify-models.py。
# Luna 自动使用 Responses API + low 推理；第三方端点也必须支持 Responses。
MODEL_API_KEY=
# 可选 OpenAI 兼容端点；需真实验证文本工具调用和图片结构化输出。
# MODEL_BASE_URL=https://your-provider.example/v1
# OpenRouter：MODEL_PROVIDER 仍为 openai（表示 SDK 接口类型）。
# MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=openai/gpt-6-luna
# VISION_MODEL=openai/gpt-6-luna
# MODEL_API_KEY 填 OpenRouter 的 API key；不要把 /responses 加到 BASE_URL。
# 2026-10-14 本人登录后的本科个人课表 DOM 已实测；其他布局需重新实测。
SCUT_ADAPTER_PATH=./config/scut-undergraduate-2026-10-14.json
